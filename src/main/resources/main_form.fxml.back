<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import javafx.scene.effect.*?>
<?import javafx.geometry.*?>
<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.inettel.cassa.MainFormController">
   <children>
      <MenuBar prefHeight="29.0" prefWidth="600.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <menus>
          <Menu mnemonicParsing="false" text="Настройки">
            <items>
              <MenuItem mnemonicParsing="false" text="Настройки" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Помощь">
            <items>
              <MenuItem mnemonicParsing="false" text="О программе" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <TableView fx:id="mainTable" layoutX="6.0" layoutY="113.0" prefHeight="215.0" prefWidth="700.0" tableMenuButtonVisible="true" AnchorPane.bottomAnchor="65.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="120.0">
        <columns>
          <TableColumn fx:id="serviceTableColumn" editable="false" maxWidth="100.0" minWidth="100.0" prefWidth="100.0" resizable="false" text="Услуга" />
          <TableColumn fx:id="accountTableColumn" maxWidth="75.0" minWidth="75.0" prefWidth="75.0" resizable="false" text="Лиц.счет" />
            <TableColumn fx:id="balanceTableColumn" maxWidth="75.0" minWidth="75.0" prefWidth="75.0" resizable="false" text="Баланс" />
            <TableColumn fx:id="streetTableColumn" maxWidth="150.0" minWidth="150.0" prefWidth="150.0" resizable="false" text="Улица" />
            <TableColumn fx:id="houseTableColumn" maxWidth="50.0" minWidth="50.0" prefWidth="50.0" resizable="false" text="Дом" />
            <TableColumn fx:id="flatTableColumn" maxWidth="75.0" minWidth="50.0" prefWidth="50.0" text="Кв." />
            <TableColumn fx:id="nameTableColumn" maxWidth="1.7976931348623157E308" minWidth="150.0" prefWidth="150.0" text="Абонент" />
            <TableColumn fx:id="tariffTableColumn" maxWidth="100.0" minWidth="100.0" prefWidth="10.0" resizable="false" text="Тариф" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
      </TableView>
      <Button fx:id="payBtn" layoutX="624.0" layoutY="361.0" mnemonicParsing="false" onAction="#doPay" text="Оплатить" AnchorPane.bottomAnchor="14.0" AnchorPane.rightAnchor="14.0">
         <font>
            <Font size="18.0" />
         </font></Button>
      <TextField fx:id="houseTextField" layoutX="14.0" layoutY="77.0" onAction="#searchClient" prefHeight="25.0" prefWidth="65.0" promptText="Дом" />
      <TextField fx:id="flatTextField" layoutX="99.0" layoutY="77.0" onAction="#searchClient" prefHeight="25.0" prefWidth="65.0" promptText="Кварт." />
      <TextField fx:id="nameTextField" layoutX="245.0" layoutY="41.0" onAction="#searchClient" promptText="Ф.И.О." />
      <TextField fx:id="accountTextField" layoutX="245.0" layoutY="78.0" onAction="#searchClient" promptText="Лицевой счет" />
      <TextField fx:id="paySumTextField" alignment="CENTER_RIGHT" layoutX="381.0" layoutY="353.0" onAction="#doPay" prefHeight="33.0" prefWidth="174.0" promptText="Сумма оплаты" AnchorPane.bottomAnchor="14.0" AnchorPane.rightAnchor="145.0">
         <font>
            <Font name="System Bold" size="18.0" />
         </font></TextField>
      <Button fx:id="findBtn" layoutX="716.0" layoutY="78.0" mnemonicParsing="false" onAction="#searchClient" prefHeight="25.0" prefWidth="100.0" text="Поиск" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="78.0" />
      <CheckBox fx:id="inetCheckBox" layoutX="485.0" layoutY="45.0" mnemonicParsing="false" selected="true" text="Интернет" />
      <CheckBox fx:id="tvCheckBox" layoutX="485.0" layoutY="81.0" mnemonicParsing="false" selected="true" text="Телевидение" />
      <ComboBox fx:id="streetComboBox" layoutX="14.0" layoutY="41.0" onAction="#findBtnSetFocus" prefWidth="150.0" />
      <Button layoutX="711.0" layoutY="42.0" mnemonicParsing="false" onAction="#clear" prefHeight="25.0" prefWidth="100.0" text="Очистить" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="42.0" />
   </children>
</AnchorPane>
